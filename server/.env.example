# ================================================================
#  把本文件复制一份，改名成  .env  ，然后填上你自己的 Token
#  （.env 不要上传到网上，也不要发给别人）
# ================================================================

# 【必填】Replicate 的 API Token
# 获取地址：https://replicate.com/account/api-tokens
# 长得像这样：r8_AbCdEf1234567890...
REPLICATE_API_TOKEN=

# 【可选】想固定模型版本时可以写成 lucataco/remove-bg:版本号
# 不填就用 lucataco/remove-bg 的最新版
# REPLICATE_MODEL=lucataco/remove-bg

# 【可选】服务端口，默认 3000
# PORT=3000

# 【可选】允许上传的最大体积（MB），默认 10
# MAX_UPLOAD_MB=10

# ================================================================
#  文字生成图片（OpenRouter）
# ================================================================

# 【必填】OpenRouter 的 API Key（用于「文字生图」页面 http://localhost:3000/imagine）
# 获取 / 管理地址：https://openrouter.ai/keys
# 长得像这样：sk-or-v1-xxxxxxxx...
OPENROUTER_API_KEY=

# 【可选】想换模型时改这里，默认 openai/gpt-5.4-image-2
# OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2

# 【可选】生图接口地址，一般不用改
# OPENROUTER_IMAGE_URL=https://openrouter.ai/api/v1/images

# 【可选】等图的最长秒数，默认 240
# OPENROUTER_TIMEOUT_SEC=240
